attempt=1
while true; do
  if render_and_test_config; then
    break
  fi

  [ "$attempt" -ge "$NGINX_TEST_MAX_ATTEMPTS" ] && die "Invalid nginx configuration generated after $NGINX_TEST_MAX_ATTEMPTS attempts (see above)"

  # nginx prints exactly one "host not found in upstream "X"" line per dead
  # host; prune every one it names and retry rather than dying on the first.
  bad_hosts=$(printf '%s\n' "$nginx_test_output" | grep -oP 'host not found in upstream "\K[^"]+' | sort -u)
  [ -z "$bad_hosts" ] && die "Invalid nginx configuration generated (see above) - not a recognised dead-mirror error, giving up"

  # If none of the named hosts belonged to any mirror array, retrying would
  # regenerate an identical config and fail the same way (e.g. nginx naming
  # dl.flathub.org rather than a mirror) - fail fast instead of burning the
  # remaining attempts.
  pruned_any=""
  while read -r bad_host; do
    prune_mirror_host "$bad_host"
    removed=1
    remove_mirror_from_array ARCH_MIRRORS "$bad_host" && removed=0
    remove_mirror_from_array CHAOTIC_AUR_MIRRORS "$bad_host" && removed=0
    remove_mirror_from_array CACHYOS_MIRRORS "$bad_host" && removed=0
    [ "$removed" = "0" ] && pruned_any=1
  done <<< "$bad_hosts"
  [ -z "$pruned_any" ] && die "Invalid nginx configuration generated (see above) - named host(s) are not a known mirror, giving up"

  attempt=$((attempt + 1))
done

