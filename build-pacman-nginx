        ENTRY=${CACHYOS_MIRRORS[i]}
        echo "        # ${ENTRY%%|*}${ENTRY#*|}"
        echo "        server 127.0.0.1:$PORT;" >> "$OUTPUT"
    done
    echo "    }" >> "$OUTPUT"
    echo ""
fi


for ((i = 0; i < ${#ARCH_MIRRORS[@]}; i++)); do
    PORT=$((ARCH_BASE_PORT + i))
    MIRROR=${ARCH_MIRRORS[i]}

    echo "Arch Server $i: $MIRROR"

    # A mirror answering with a redirect is followed here, server-side, rather
    # than relaying the 3xx: the front-end cache only stores 200s, and a client
    # restricted to reaching only this cache cannot follow a Location pointing
    # at the public internet (the chaotic.cx fleet became redirect-only, and any
    # other mirror kind could make the same move). recursive_error_pages lets a
    # multi-hop redirect chain re-enter @follow_redirect; nginx's internal
    # redirect cap of 10 bounds a redirect loop. @follow_redirect deliberately
    # sets its own proxy_set_header (cutting off inheritance of the mirror's
    # Host) so the Host sent is the redirect target's own.
    cat << EOF >> "$OUTPUT"
    server {

        listen 127.0.0.1:$PORT;

        recursive_error_pages on;

        location / {
            rewrite ^/repo/(.*)$ /\$1  break;

            proxy_pass https://$MIRROR;
            proxy_ssl_server_name on;
            proxy_set_header Host $MIRROR;
            proxy_http_version  1.1;
            proxy_set_header    Connection "";
            proxy_intercept_errors on;
            error_page 301 302 303 307 308 = @follow_redirect;
        }

        location @follow_redirect {
            # Captured via set (rewrite phase) because by the time a variable
            # proxy_pass is evaluated the new upstream has already reset
            # \$upstream_http_location to empty - confirmed live: without the
            # set, nginx fails with 'invalid URL prefix in ""'.
            set \$redirect_target \$upstream_http_location;
            # Only https targets: a compromised mirror's Location must not be
            # able to point this proxy at internal plain-http services (SSRF).
            # Also turns an empty/relative Location into a clean 502, which
            # the front end's proxy_next_upstream retries on another mirror.
            if (\$redirect_target !~ ^https://) { return 502; }
            proxy_pass \$redirect_target;
            proxy_ssl_server_name on;
            proxy_http_version  1.1;
            proxy_set_header    Connection "";
            proxy_intercept_errors on;
            error_page 301 302 303 307 308 = @follow_redirect;
        }
    }

EOF
done

for ((i = 0; i < ${#CHAOTIC_AUR_MIRRORS[@]}; i++)); do
