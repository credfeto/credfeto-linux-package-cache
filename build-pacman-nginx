# Appended, not overwritten, so a run that takes several attempts to
# converge keeps every attempt's output, not just the last one; the log is
# truncated fresh at the start of each script run (see below), so this
# never grows across separate runs.
printf '%s\n' "$nginx_test_output" >> "$NGINX_TEST_LOG"
return $status
}

# Truncated once here, then appended to on every attempt inside
# render_and_test_config, so a run that takes several attempts to converge
# keeps all of them in the log, not just the last.
: > "$NGINX_TEST_LOG"

attempt=1
while true; do
  if render_and_test_config; then
    break
  fi

  [ "$attempt" -ge "$NGINX_TEST_MAX_ATTEMPTS" ] && die "Invalid nginx configuration generated after $NGINX_TEST_MAX_ATTEMPTS attempts (see above, or $NGINX_TEST_LOG)"

  # nginx prints exactly one "host not found in upstream "X"" line per dead
  # host; prune every one it names and retry rather than dying on the first.
  bad_hosts=$(printf '%s\n' "$nginx_test_output" | grep -oP 'host not found in upstream "\K[^"]+' | sort -u)
  [ -z "$bad_hosts" ] && die "Invalid nginx configuration generated (see above, or $NGINX_TEST_LOG) - not a recognised dead-mirror error, giving up"

  # If none of the named hosts belonged to any mirror array, retrying would
  # regenerate an identical config and fail the same way (e.g. nginx naming
  # dl.flathub.org rather than a mirror) - fail fast instead of burning the
  # remaining attempts.
  pruned_any=""
  while read -r bad_host; do
    prune_mirror_host "$bad_host" && pruned_any=1
  done <<< "$bad_hosts"
  [ -z "$pruned_any" ] && die "Invalid nginx configuration generated (see above, or $NGINX_TEST_LOG) - named host(s) are not a known mirror, giving up"

  # Arch and Chaotic AUR are mandatory (see the equivalent check on the
  # initial load, above); pruning either down to empty would otherwise only
  # surface next attempt as an empty "upstream" block, which nginx reports
  # in different words entirely - not the "host not found" text bad_hosts
  # looks for above - dying here with a clear reason instead of the
  # generic "not a recognised dead-mirror error" that would follow.
  [ "${#ARCH_MIRRORS[@]}" -eq 0 ] && die "Pruning left no Arch mirrors to serve from (see above, or $NGINX_TEST_LOG)"
  [ "${#CHAOTIC_AUR_MIRRORS[@]}" -eq 0 ] && die "Pruning left no Chaotic AUR mirrors to serve from (see above, or $NGINX_TEST_LOG)"

  attempt=$((attempt + 1))
done

sudo cp "$OUTPUT" "$BASEDIR/pacman/nginx.conf"
sudo cp "$OUTPUT" "/etc/nginx/nginx.conf"
sudo nginx -s reload

success "nginx config regenerated and reloaded"

fi
