EOF
done

if [ "${#CACHYOS_MIRRORS[@]}" -gt 0 ]; then
    for ((i = 0; i < ${#CACHYOS_MIRRORS[@]}; i++)); do
        PORT=$((CACHYOS_BASE_PORT + i))
        ENTRY=${CACHYOS_MIRRORS[i]}
        MIRROR_HOST=${ENTRY%%|*}
        MIRROR_PATH=${ENTRY#*|}

        echo "CachyOS Server $i: $MIRROR_HOST$MIRROR_PATH"

        # Client-facing requests arrive here as /repo/cachyos/$arch/$repo/<file> (the
