EOF
done

for ((i = 0; i < ${#CHAOTIC_AUR_MIRRORS[@]}; i++)); do
    PORT=$((CHAOTIC_AUR_BASE_PORT + i))
    MIRROR=${CHAOTIC_AUR_MIRRORS[i]}

    echo "Chaotic AUR Server $i: $MIRROR"

    cat << EOF >> "$OUTPUT"
