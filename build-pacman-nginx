# repo arg|matcher function|mirror array name. Refresh, load, and the retry
# driver's pruning all iterate this one table, so a fourth mirror kind is
# one more row here rather than a fourth copy of any of those three loops.
declare -a MIRROR_SPECS=(
  "$MIRRORLIST_ARCH|Arch|arch|is_arch_url|ARCH_MIRRORS"
  "$MIRRORLIST_CHAOTIC|Chaotic AUR|chaotic-aur|is_chaotic_aur_url|CHAOTIC_AUR_MIRRORS"
  "$MIRRORLIST_CACHYOS|CachyOS|cachyos|is_cachyos_url|CACHYOS_MIRRORS"
)

