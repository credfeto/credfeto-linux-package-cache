            # able to point this proxy at internal plain-http services (SSRF).
            # Also turns an empty/relative Location into a clean 502, which
            # the front end's proxy_next_upstream retries on another mirror.
            if (\$redirect_target !~ ^https://) { return 502; }
            proxy_pass \$redirect_target;
            proxy_ssl_server_name on;
            proxy_http_version  1.1;
            proxy_set_header    Connection "";
            proxy_intercept_errors on;
            error_page 301 302 303 307 308 = @follow_redirect;
        }
    }

EOF
done

if [ "${#CACHYOS_MIRRORS[@]}" -gt 0 ]; then
    for ((i = 0; i < ${#CACHYOS_MIRRORS[@]}; i++)); do
        PORT=$((CACHYOS_BASE_PORT + i))
        ENTRY=${CACHYOS_MIRRORS[i]}
        MIRROR_HOST=${ENTRY%%|*}
