        # fixed "/repo/cachyos" prefix for this mirror's own path prefix before proxying,
        # since real CachyOS mirrors don't agree on what that prefix is.
        # Same server-side redirect following as the Arch blocks above.
        cat << EOF >> "$OUTPUT"
