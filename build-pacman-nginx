# rather than every one at once, so several simultaneously-dead mirrors
# could each need their own attempt. Each attempt is cheap (no DNS
# re-check, no mirrorlist reload - see render_and_test_config), so a
# generous cap costs little and avoids giving up while pruning is still
# making genuine progress.
NGINX_TEST_MAX_ATTEMPTS=20

MIRRORLIST_ARCH="$BASEDIR/mirrorlists/arch"
MIRRORLIST_CHAOTIC="$BASEDIR/mirrorlists/chaotic"
MIRRORLIST_CACHYOS="$BASEDIR/mirrorlists/cachyos"

