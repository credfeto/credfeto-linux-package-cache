#! /bin/bash

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

is_arch_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/archlinux/\$repo/os/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_chaotic_aur_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/\$repo/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_cachyos_url()
{
  url=$1
  # CachyOS mirrors don't share Arch/Chaotic's uniform layout: $arch/$repo are
  # reversed vs Arch's own convention, and each mirror has its own path prefix
  # (e.g. /cachyos/repo, /mirror/cachyos/repo, /repo) before that. Capture the
  # host and that per-mirror prefix separately so both can be reassembled correctly.
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+)(/.+)/\$arch/\$repo$'

  if [[ "$url" =~ $regex_pattern ]]; then
      host=${BASH_REMATCH[1]}
      prefix=${BASH_REMATCH[2]}
      echo "$host|$prefix"
  fi
}

is_resolvable()
{
  host=$1
  getent hosts "$host" > /dev/null 2>&1
}

# Drops a dead mirror host from every mirrorlist file that mentions it, so a
# host found unresolvable or rejected by nginx -t doesn't keep coming back on
# every run between full re-ranks.
prune_mirror_host()
{
  host=$1
  for list in "${MIRRORLIST_FILES[@]}"; do
    if [ -f "$list" ] && grep -qF "$host" "$list"; then
      info "Pruning unreachable mirror $host from $list"
      grep -vF "$host" "$list" > "$list.tmp" && mv "$list.tmp" "$list"
    fi
  done
}

# A mirrorlist is due for a full rate-mirrors re-rank if it is missing or has
# not been refreshed in MIRRORLIST_MAX_AGE_DAYS days, so mirrors that quietly
# rot (or better ones that appear) get picked up on a routine cadence rather
# than only once at first bootstrap.
needs_mirrorlist_refresh()
{
  file=$1
  [ -f "$file" ] || return 0
  [ -n "$(find "$file" -mtime "+${MIRRORLIST_MAX_AGE_DAYS}" 2>/dev/null)" ]
}

# Parses $list_file with $matcher_fn (one of the is_*_url functions above)
# into the array named $3, skipping and pruning any host that doesn't
# resolve. Shared by all three mirror kinds so a fourth kind is one row in
# MIRROR_LOAD_SPECS below rather than a fourth copy of this loop.
load_mirrors()
{
  local matcher_fn=$1
  local list_file=$2
  local -n out_array=$3
  local line match host_part

  out_array=()
  while read -r line
  do
    if [ -n "$line" ]; then
      match=$("$matcher_fn" "$line")
      if [ -n "$match" ]; then
        host_part=${match%%|*}
        if is_resolvable "$host_part"; then
          echo " * $match"
          out_array+=("$match")
        else
          info "Skipping unresolvable mirror: $host_part"
          prune_mirror_host "$host_part"
        fi
      fi
    fi
  done < "$list_file"
  echo "Found: ${#out_array[@]}"
}

# Removes any entry from the named mirror array whose host (the text before
# "|" for CachyOS's "host|prefix" entries, or the whole entry for
# arch/chaotic) is $2. Returns success only if something was actually
# removed, so callers can tell "this was one of our mirrors" apart from
# nginx naming some other host (e.g. dl.flathub.org) as unreachable.
remove_mirror_from_array()
{
  local -n arr=$1
  local host=$2
  local -a kept=()
  local entry removed=1

  for entry in "${arr[@]}"; do
    if [ "${entry%%|*}" = "$host" ]; then
      removed=0
    else
      kept+=("$entry")
    fi
  done
  arr=("${kept[@]}")
  return $removed
}

