#! /bin/bash

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

is_arch_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/archlinux/\$repo/os/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_chaotic_aur_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/\$repo/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_cachyos_url()
{
  url=$1
  # CachyOS mirrors don't share Arch/Chaotic's uniform layout: $arch/$repo are
  # reversed vs Arch's own convention, and each mirror has its own path prefix
  # (e.g. /cachyos/repo, /mirror/cachyos/repo, /repo) before that. Capture the
  # host and that per-mirror prefix separately so both can be reassembled correctly.
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+)(/.+)/\$arch/\$repo$'

  if [[ "$url" =~ $regex_pattern ]]; then
      host=${BASH_REMATCH[1]}
      prefix=${BASH_REMATCH[2]}
      echo "$host|$prefix"
  fi
}

# A single failed lookup permanently prunes the mirror (until the next
# weekly re-rank), so a lone transient resolver hiccup shouldn't be enough
# to condemn an otherwise-healthy mirror - retry a couple of times first.
is_resolvable()
{
  host=$1
  for _ in 1 2 3; do
    getent hosts "$host" > /dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# Drops a dead mirror host from every mirrorlist file that mentions it (all
# of them, not just the one it was found in - a host is only ever pruned
# because it's dead, so removing it everywhere is always correct) and from
# its mirror array, so a host found unresolvable or rejected by nginx -t
# doesn't keep coming back on every run between full re-ranks and doesn't
# linger in the array render_and_test_config works from. Reads MIRROR_SPECS
# for both the file list (field 1) and the array name (field 5) rather than
# a separate enumeration or a second pass over the table. Returns success
# only if something was actually removed (file or array), so callers can
# tell "this was one of our mirrors" apart from nginx naming some other host
# (e.g. dl.flathub.org) as unreachable.
prune_mirror_host()
{
  host=$1
  removed=1
  for spec in "${MIRROR_SPECS[@]}"; do
    IFS='|' read -r list _ _ _ array_name <<< "$spec"
    # Matches on "://$host/", not bare "$host": every mirrorlist line is a
    # "Server = https://HOST/..." URL, so a bare substring match would also
    # strip an unrelated, healthy mirror whose name contains this host as a
    # substring (e.g. pruning mirror1.example.com would also match
    # sub.mirror1.example.com). The scheme delimiter before and the path
    # separator immediately after are exactly HOST's boundaries in that URL.
    if [ -f "$list" ] && grep -qF "://$host/" "$list"; then
      info "Pruning unreachable mirror $host from $list"
      # Not "grep -vF ... && mv": grep -v exits 1 (not 0) when the pruned
      # host was the file's last surviving line, since it then has zero
      # matching lines to output - that would skip the mv via && and leave
      # the dead mirror in the file. The "|| true" makes the redirect (which
      # always creates $list.tmp, even empty) the only thing that matters
      # here, so mv always follows regardless of grep's own exit status.
      grep -vF "://$host/" "$list" > "$list.tmp" || true
      mv "$list.tmp" "$list"
      removed=0
    fi
    remove_mirror_from_array "$array_name" "$host" && removed=0
  done
  return $removed
}

# A mirrorlist is due for a full rate-mirrors re-rank if it is missing, or
# its ".ranked" marker is missing or older than MIRRORLIST_MAX_AGE_DAYS days,
# so mirrors that quietly rot (or better ones that appear) get picked up on
# a routine cadence rather than only once at first bootstrap. Staleness is
# tracked via a separate marker file, touched only on a real re-rank
# (see MIRROR_SPECS loop below), rather than the mirrorlist file's own
# mtime: prune_mirror_host rewrites that file too, so using its mtime would
# mean every pruned mirror resets the re-rank clock - the list could only
# ever shrink between re-ranks instead of being topped back up.
needs_mirrorlist_refresh()
{
  file=$1
  marker="$file.ranked"
  [ -f "$file" ] || return 0
  # A list pruned down to zero entries (every mirror it had went unreachable
  # between re-ranks) must not wait out the rest of the staleness window
  # with nothing to load - that's exactly the "stays broken until someone
  # notices" failure mode this whole self-heal mechanism exists to avoid.
  [ -s "$file" ] || return 0
  [ -f "$marker" ] || return 0
  [ -n "$(find "$marker" -mtime "+${MIRRORLIST_MAX_AGE_DAYS}" 2>/dev/null)" ]
}

# Parses $list_file with $matcher_fn (one of the is_*_url functions above)
# into the array named $3, skipping and pruning any host that doesn't
# resolve. Pruning (via prune_mirror_host) checks every mirrorlist file, not
# just $list_file, so loading one list can also rewrite another's file if
# the same dead host is somehow listed in both. Shared by all three mirror
# kinds so a fourth kind is one row in MIRROR_SPECS below rather than a
# fourth copy of this loop.
load_mirrors()
{
  local matcher_fn=$1
  local list_file=$2
  # See remove_mirror_from_array for why this isn't a name a caller's own
  # array is likely to collide with.
  local -n _out_array=$3
  local line match host_part

  _out_array=()
  while read -r line
  do
    if [ -n "$line" ]; then
      match=$("$matcher_fn" "$line")
      if [ -n "$match" ]; then
        host_part=${match%%|*}
        if is_resolvable "$host_part"; then
          echo " * $match"
          _out_array+=("$match")
        else
          info "Skipping unresolvable mirror: $host_part"
          prune_mirror_host "$host_part"
        fi
      fi
    fi
  done < "$list_file"
  echo "Found: ${#_out_array[@]}"
}

# Removes any entry from the named mirror array whose host (the text before
# "|" for CachyOS's "host|prefix" entries, or the whole entry for
# arch/chaotic) is $2. Returns success only if something was actually
# removed, so callers can tell "this was one of our mirrors" apart from
# nginx naming some other host (e.g. dl.flathub.org) as unreachable.
remove_mirror_from_array()
{
  # Named "_target_array", not "arr", so a caller whose own array happens to
  # be called "arr" doesn't hit bash's "circular name reference" error - a
  # nameref can't share a name with its own target.
  local -n _target_array=$1
  local host=$2
  local -a kept=()
  local entry removed=1

  for entry in "${_target_array[@]}"; do
    if [ "${entry%%|*}" = "$host" ]; then
      removed=0
    else
      kept+=("$entry")
    fi
  done
  _target_array=("${kept[@]}")
  return $removed
}

