ARCH_BASE_PORT=8000
CHAOTIC_AUR_BASE_PORT=9000
CACHYOS_BASE_PORT=10000

MIRRORLIST_MAX_AGE_DAYS=7
NGINX_TEST_MAX_ATTEMPTS=5

MIRRORLIST_ARCH="$BASEDIR/mirrorlists/arch"
MIRRORLIST_CHAOTIC="$BASEDIR/mirrorlists/chaotic"
MIRRORLIST_CACHYOS="$BASEDIR/mirrorlists/cachyos"
declare -a MIRRORLIST_FILES=("$MIRRORLIST_ARCH" "$MIRRORLIST_CHAOTIC" "$MIRRORLIST_CACHYOS")

# Assume Rate mirrors is defined
sudo pacman -S --needed --noconfirm rate-mirrors

declare -a MIRROR_REFRESH_SPECS=(
  "$MIRRORLIST_ARCH|Arch|arch"
  "$MIRRORLIST_CHAOTIC|Chaotic AUR|chaotic-aur"
  "$MIRRORLIST_CACHYOS|CachyOS|cachyos"
)
for spec in "${MIRROR_REFRESH_SPECS[@]}"; do
  IFS='|' read -r mirrorlist_file label rate_mirrors_repo <<< "$spec"
  if needs_mirrorlist_refresh "$mirrorlist_file"; then
    info "$label mirror list missing or older than $MIRRORLIST_MAX_AGE_DAYS days - re-ranking"
    rate-mirrors --allow-root --protocol=https --save "$mirrorlist_file" "$rate_mirrors_repo" || die "Could not load $label mirrors"
  fi
done

declare -a ARCH_MIRRORS=()
declare -a CHAOTIC_AUR_MIRRORS=()
declare -a CACHYOS_MIRRORS=()

declare -a MIRROR_LOAD_SPECS=(
  "is_arch_url|$MIRRORLIST_ARCH|ARCH_MIRRORS|Arch"
  "is_chaotic_aur_url|$MIRRORLIST_CHAOTIC|CHAOTIC_AUR_MIRRORS|Chaotic AUR"
  "is_cachyos_url|$MIRRORLIST_CACHYOS|CACHYOS_MIRRORS|CachyOS"
)
for spec in "${MIRROR_LOAD_SPECS[@]}"; do
  IFS='|' read -r matcher_fn list_file out_array_name label <<< "$spec"
  info "Loading: $label Mirrors"
  load_mirrors "$matcher_fn" "$list_file" "$out_array_name"
done

