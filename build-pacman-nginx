#! /bin/bash

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

is_arch_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/archlinux/\$repo/os/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_chaotic_aur_url()
{
  url=$1
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+?)/\$repo/\$arch$'

  if [[ "$url" =~ $regex_pattern ]]; then
      domain=${BASH_REMATCH[1]}
      echo "$domain"
  fi
}

is_cachyos_url()
{
  url=$1
  # CachyOS mirrors don't share Arch/Chaotic's uniform layout: $arch/$repo are
  # reversed vs Arch's own convention, and each mirror has its own path prefix
  # (e.g. /cachyos/repo, /mirror/cachyos/repo, /repo) before that. Capture the
  # host and that per-mirror prefix separately so both can be reassembled correctly.
  # shellcheck disable=SC2016 # $repo/$arch are literal pacman.conf tokens, not shell variables
  regex_pattern='^Server = https://([^/]+)(/.+)/\$arch/\$repo$'

  if [[ "$url" =~ $regex_pattern ]]; then
      host=${BASH_REMATCH[1]}
      prefix=${BASH_REMATCH[2]}
      echo "$host|$prefix"
  fi
}

is_resolvable()
{
  host=$1
  getent hosts "$host" > /dev/null 2>&1
}

# Drops a dead mirror host from whichever mirrorlist file(s) mention it, so a
# host found unresolvable or rejected by nginx -t doesn't keep coming back on
# every run between full re-ranks.
prune_mirror_host()
{
  host=$1
  for list in "$BASEDIR/mirrorlists/arch" "$BASEDIR/mirrorlists/chaotic" "$BASEDIR/mirrorlists/cachyos"; do
    if [ -f "$list" ] && grep -qF "$host" "$list"; then
      info "Pruning unreachable mirror $host from $list"
      grep -vF "$host" "$list" > "$list.tmp" && mv "$list.tmp" "$list"
    fi
  done
}

# A mirrorlist is due for a full rate-mirrors re-rank if it is missing or has
# not been refreshed in MIRRORLIST_MAX_AGE_DAYS days, so mirrors that quietly
# rot (or better ones that appear) get picked up on a routine cadence rather
# than only once at first bootstrap.
needs_mirrorlist_refresh()
{
  file=$1
  [ -f "$file" ] || return 0
  [ -n "$(find "$file" -mtime "+${MIRRORLIST_MAX_AGE_DAYS}" 2>/dev/null)" ]
}

BASEDIR="$(dirname "$(readlink -f "$0")")"
OUTPUT="$BASEDIR/nginx.test.conf"
NGINX_TEST_LOG="$BASEDIR/nginx-test.log"

ARCH_BASE_PORT=8000
CHAOTIC_AUR_BASE_PORT=9000
CACHYOS_BASE_PORT=10000

MIRRORLIST_MAX_AGE_DAYS=7
NGINX_TEST_MAX_ATTEMPTS=5

# Assume Rate mirrors is defined
sudo pacman -S --needed --noconfirm rate-mirrors

if needs_mirrorlist_refresh "$BASEDIR/mirrorlists/arch"; then
  info "Arch mirror list missing or older than $MIRRORLIST_MAX_AGE_DAYS days - re-ranking"
  rate-mirrors --allow-root --protocol=https --save "$BASEDIR/mirrorlists/arch" arch || die "Could not load arch mirrors"
fi
if needs_mirrorlist_refresh "$BASEDIR/mirrorlists/chaotic"; then
  info "Chaotic AUR mirror list missing or older than $MIRRORLIST_MAX_AGE_DAYS days - re-ranking"
  rate-mirrors --allow-root --protocol=https --save "$BASEDIR/mirrorlists/chaotic" chaotic-aur || die "Could not load chaotic mirrors"
fi
if needs_mirrorlist_refresh "$BASEDIR/mirrorlists/cachyos"; then
  info "CachyOS mirror list missing or older than $MIRRORLIST_MAX_AGE_DAYS days - re-ranking"
  rate-mirrors --allow-root --protocol=https --save "$BASEDIR/mirrorlists/cachyos" cachyos || die "Could not load cachyos mirrors"
fi

# Builds nginx.test.conf from the current mirrorlist files and runs nginx -t
# against it. Returns nginx -t's exit status so the retry driver below can
# tell a genuinely bad config apart from one that just needs a dead mirror
# pruned. Re-declaring the mirror arrays here (they are function-local
# because of "declare") means each retry re-loads from disk and picks up
# whatever prune_mirror_host has just removed.
build_and_test_config()
{
info "Loading: Arch Mirrors"
declare -a ARCH_MIRRORS=()
declare -a ARCH_UNRESOLVABLE=()
while read -r line
do
  if [ -n "$line" ]; then
    match=$(is_arch_url "$line")
    if [ -n "$match" ]; then
      if is_resolvable "$match"; then
        echo " * $match"
        ARCH_MIRRORS+=("$match")
      else
        info "Skipping unresolvable arch mirror: $match"
        ARCH_UNRESOLVABLE+=("$match")
      fi
    fi

  fi
done < "$BASEDIR/mirrorlists/arch"
for host in "${ARCH_UNRESOLVABLE[@]}"; do
  prune_mirror_host "$host"
done

echo "Found: ${#ARCH_MIRRORS[@]}"

info "Loading: Chaotic AUR Mirrors"

declare -a CHAOTIC_AUR_MIRRORS=()
declare -a CHAOTIC_AUR_UNRESOLVABLE=()
while read -r line
do
  if [ -n "$line" ]; then
    match=$(is_chaotic_aur_url "$line")
    if [ -n "$match" ]; then
      if is_resolvable "$match"; then
        echo " * $match"
        CHAOTIC_AUR_MIRRORS+=("$match")
      else
        info "Skipping unresolvable chaotic mirror: $match"
        CHAOTIC_AUR_UNRESOLVABLE+=("$match")
      fi
    fi
  fi
done < "$BASEDIR/mirrorlists/chaotic"
for host in "${CHAOTIC_AUR_UNRESOLVABLE[@]}"; do
  prune_mirror_host "$host"
done

info "Loading: CachyOS Mirrors"

declare -a CACHYOS_MIRRORS=()
declare -a CACHYOS_UNRESOLVABLE=()
while read -r line
do
  if [ -n "$line" ]; then
    match=$(is_cachyos_url "$line")
    if [ -n "$match" ]; then
      host=${match%%|*}
      if is_resolvable "$host"; then
        echo " * $match"
        CACHYOS_MIRRORS+=("$match")
      else
        info "Skipping unresolvable cachyos mirror: $host"
        CACHYOS_UNRESOLVABLE+=("$host")
      fi
    fi
  fi
done < "$BASEDIR/mirrorlists/cachyos"
for host in "${CACHYOS_UNRESOLVABLE[@]}"; do
  prune_mirror_host "$host"
done


echo ""
echo "Summary:"
echo " * Arch Mirrors: ${#ARCH_MIRRORS[@]}"
echo " * Chaotic AUR Mirrors: ${#CHAOTIC_AUR_MIRRORS[@]}"
echo " * CachyOS Mirrors: ${#CACHYOS_MIRRORS[@]}"
[ "${#ARCH_MIRRORS[@]}" = "0" ] && die "No Arch Mirrors found"
[ "${#CHAOTIC_AUR_MIRRORS[@]}" = "0" ] && die "No Chaotic AUR Mirrors found"
# CachyOS is optional third-party support layered on top of the core Arch/Chaotic-AUR
# cache: losing it for a run (mirror list glitch, upstream layout change) must not
# block regenerating everything else, so this warns and omits CachyOS instead of dying.
