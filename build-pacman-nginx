if [ "${#CACHYOS_MIRRORS[@]}" -gt 0 ]; then
    echo "    upstream cachyos-mirrors {" >> "$OUTPUT"
    echo "        keepalive 64;" >> "$OUTPUT"
    for ((i = 0; i < ${#CACHYOS_MIRRORS[@]}; i++)); do
        PORT=$((CACHYOS_BASE_PORT + i))
        ENTRY=${CACHYOS_MIRRORS[i]}
        echo "        # ${ENTRY%%|*}${ENTRY#*|}"
        echo "        server 127.0.0.1:$PORT;" >> "$OUTPUT"
    done
    echo "    }" >> "$OUTPUT"
    echo ""
fi


for ((i = 0; i < ${#ARCH_MIRRORS[@]}; i++)); do
    PORT=$((ARCH_BASE_PORT + i))
    MIRROR=${ARCH_MIRRORS[i]}

    echo "Arch Server $i: $MIRROR"

    cat << EOF >> "$OUTPUT"
