        listen 127.0.0.1:$PORT;

        location / {
            rewrite ^/repo/(.*)$ /\$1  break;

            proxy_pass https://$MIRROR;
            proxy_ssl_server_name on;
            proxy_set_header Host $MIRROR;
            proxy_http_version  1.1;
            proxy_set_header    Connection "";
        }
